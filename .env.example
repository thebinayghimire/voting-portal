# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git.

# --- Required ---

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_long_random_hex

# Admin login.
ADMIN_USERNAME=admin

# bcrypt hash of your admin password. Generate with:
#   node gen-hash.js YourStrongPasswordHere
ADMIN_PASSWORD_HASH=replace_me_with_bcrypt_hash

# Election window. Use ISO 8601 with timezone offset.
# Nepal is +05:45.
ELECTION_OPEN_AT=2026-05-15T09:00:00+05:45
ELECTION_CLOSE_AT=2026-05-15T15:00:00+05:45

# --- Optional ---

# When to allow /admin/results. Defaults to ELECTION_CLOSE_AT if unset.
# RESULTS_VISIBLE_AFTER=2026-05-15T15:00:00+05:45

# Optional second-person code for viewing final results.
# Generate with: node gen-hash.js YourResultsRevealCode
# RESULTS_ACCESS_CODE_HASH=replace_me_with_bcrypt_hash

# Optional admin API IP allowlist. Comma-separated exact IPs.
# Leave blank for local testing or if your school network IP changes often.
# ADMIN_ALLOWED_IPS=203.0.113.10,127.0.0.1

# Runtime data directory for votes.db, sessions, and backups.
# On Render with a persistent disk, set DATA_DIR=/var/data.
# DATA_DIR=/var/data

# Optional Backblaze B2 cloud backup. If all three are set, every local DB
# backup is also uploaded to the bucket.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_ID=
# B2_PREFIX=voting-portal-backups

# Number of local DB snapshots to retain.
# BACKUP_RETAIN=100

# Optional extra salt used for anonymized voter hashes in backups/vote-ledger.jsonl.
# Defaults to SESSION_SECRET if unset. For a real election, set a separate random value.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# VOTE_LEDGER_SALT=

# Set to "production" only when deployed (enables HTTPS redirect, secure cookies)
# Leave unset or set to "development" for local testing.
NODE_ENV=development

# Port. Local default is 3000. Render sets this automatically — do NOT set it there.
PORT=3000
